{
  "builds": [
    {
      "src": "TaskDuty/ClientSide/vite-project/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "TaskDuty/ServerSide/src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/TaskDuty/ServerSide/src/server.ts" },
    { "src": "/(.*)", "dest": "/TaskDuty/ClientSide/vite-project/src/app.tsx" }
  ]
}